{
  "name": "@social-agent/dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node -e \"const fs=require('fs'); if(fs.existsSync('.next/BUILD_ID')){ fs.rmSync('.next',{recursive:true,force:true}); console.log('[dashboard] cleared production .next before dev'); }\"",
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:pwa": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "node --import tsx --test lib/opportunity-map-interaction.test.ts lib/calendar-local-date.test.ts lib/ask-benson-types.test.ts"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@social-agent/core": "workspace:*",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "simple-icons": "^13.21.0"
  },
  "devDependencies": {
    "@types/google.maps": "^3.65.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  }
}
