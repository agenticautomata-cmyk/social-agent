# --- Postgres ---
POSTGRES_USER=social_agent
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=social_agent
POSTGRES_PORT=5432

# --- n8n ---
N8N_USER=admin
N8N_PASSWORD=change_me_strong_password
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
TZ=Europe/Berlin

# --- LLM / image / avatar ---
OPENAI_API_KEY=sk-...
HEYGEN_API_KEY=
GOOGLE_AI_API_KEY=

# --- Social platforms (Phase 5) ---
# Instagram (Graph API via Facebook app)
IG_APP_ID=
IG_APP_SECRET=
# Long-lived page access token; rotate via refresh flow
IG_PAGE_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# TikTok (Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# --- Asset storage (Phase 3) ---
# Either S3-compatible or local. Default: local volume mounted into n8n.
ASSET_STORAGE=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=

# --- Notifications (Phase 1) ---
# Slack webhook for HITL approval requests + failure alerts
SLACK_WEBHOOK_URL=
