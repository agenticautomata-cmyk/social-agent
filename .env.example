# ============================================================================
# DEMO MODE
# ============================================================================
# When true, all external providers (OpenAI, HeyGen, Imagen, IG, TikTok) use
# mocks that return realistic data with realistic delays. Flip individual
# providers to real by setting their API key + DEMO_MODE=false.
DEMO_MODE=true

# --- Postgres ---
POSTGRES_USER=social_agent
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_DB=social_agent
POSTGRES_PORT=5433
DATABASE_URL=postgres://social_agent:dev_password_change_me@localhost:5433/social_agent

# --- API ---
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Workers ---
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=5

# --- n8n ---
N8N_USER=admin
N8N_PASSWORD=change_me_strong_password
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
TZ=America/Chicago
# IANA timezone for posting-time analytics and UI display (Central Time — CST/CDT)
CREATOR_TIMEZONE=America/Chicago
# Display name Benson uses when addressing the creator
# CREATOR_DISPLAY_NAME=Kellie
# Next.js server rewrites proxy to API (same host as dashboard — avoid tunnel hairpin)
# BENSON_INTERNAL_API_URL=http://127.0.0.1:4000
# BENSON_ASK_MODEL=gpt-4o-mini
# BENSON_ASK_DEEP_MODEL=gpt-4o
# Model used with OpenAI web_search tool (upload enrichment + source replacement research)
# BENSON_WEB_SEARCH_MODEL=gpt-4o-mini
# Benson brain worker intervals (ms)
# BENSON_PULSE_INTERVAL_MS=14400000         # TikTok pulse: sync + progress brief (4 h)
# BENSON_OPPORTUNITY_REFRESH_MS=21600000    # source refresh + opportunity scoring (6 h)
# BENSON_SOURCE_HEALTH_MS=86400000          # broken-feed health check (24 h)

# --- LLM / image / avatar ---
OPENAI_API_KEY=sk-...
HEYGEN_API_KEY=
GOOGLE_AI_API_KEY=

# --- Social platforms (Phase 5) ---
# Instagram / Meta (Graph API — Phase E read-only analytics OAuth)
IG_APP_ID=
IG_APP_SECRET=
# Local dev: localhost callback. Production: omit or use public URL — when IG_APP_ID is set,
# Benson uses https://api.kckellie.com/api/analytics/meta/oauth/callback automatically.
META_REDIRECT_URI=http://localhost:4000/api/analytics/meta/oauth/callback
# Optional: force a specific Facebook Page when multiple are returned
# META_PAGE_ID=
# Legacy manual tokens (optional fallback)
IG_PAGE_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# TikTok (Content Posting API — legacy worker publishing)
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# TikTok OAuth (Phase B — Benson analytics connection UI)
# Register this exact URI in TikTok Developer Portal → Login Kit → Redirect URI (Sandbox tab too):
# https://api.kckellie.com/api/analytics/tiktok/oauth/callback
# Local dev only: http://localhost:4000/api/analytics/tiktok/oauth/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://api.kckellie.com/api/analytics/tiktok/oauth/callback
# Optional: override Login Kit scopes (comma-separated, URL-encoded automatically)
# TIKTOK_OAUTH_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.list
# Optional: sandbox | production — otherwise inferred from client key prefix (sb* = sandbox)
# TIKTOK_CLIENT_MODE=sandbox

# Optional: dashboard base URL for OAuth callback redirects (defaults to http://localhost:3000)
# DASHBOARD_PUBLIC_URL=http://localhost:3000

# Public API base for uploaded media kit file URLs (production: https://api.kckellie.com)
# API_PUBLIC_URL=https://api.kckellie.com
# MEDIA_KIT_PUBLIC_BASE=https://api.kckellie.com
# MEDIA_KIT_UPLOAD_DIR=/path/to/uploads/media-kits

# --- Asset storage (Phase 3) ---
# Either S3-compatible or local. Default: local volume mounted into n8n.
ASSET_STORAGE=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=

# --- Notifications (Phase 1) ---
# Slack webhook for HITL approval requests + failure alerts
SLACK_WEBHOOK_URL=
# Web push (Benson PWA) — generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- Sponsor outreach Phase B (Resend live send) ---
# OUTREACH_ENABLE_LIVE_SEND=false
# RESEND_API_KEY=
# OUTREACH_FROM_EMAIL=Kellie <outreach@yourdomain.com>
# OUTREACH_REPLY_TO=kellie@example.com

# ============================================================================
# BENSON FEATURE FLAGS (Phase 1) — all default false; see FEATURE_FLAGS_SIMPLIFIED.md
# ============================================================================
# DISABLE_VIDEO_PIPELINE=false
# ENABLE_OPPORTUNITIES_API=false
# ENABLE_BENSON_BRANDING=false
# ENABLE_OPPORTUNITIES_UI=false
# ENABLE_BENSON_TERMINOLOGY=false
# ENABLE_WORKER_LABEL_ALIASES=false
# ENABLE_BENSON_SEED_NAMES=false
# ENABLE_BENSON_DEMO_SCRIPT=false
# ENABLE_KC_SCANNER=false
# ENABLE_TIKTOK_PUBLISH=false

# Optional override for Benson dance sprite sheet
# NEXT_PUBLIC_BENSON_SPRITE=/animations/benson-dance.webp


# Creator contact routing (Cloudflare Email Routing → kckellie.com)
CREATOR_GMAIL_SEND_AS=kckelliecreator@gmail.com
CREATOR_EMAIL_CONTACT=contact@kckellie.com
CREATOR_EMAIL_SPONSORS=sponsors@kckellie.com
CREATOR_EMAIL_MEDIA=media@kckellie.com
CREATOR_EMAIL_COLLABS=collabs@kckellie.com
CREATOR_EMAIL_BOOKING=booking@kckellie.com

# Gmail sponsor outreach
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
OUTREACH_SEND_PROVIDER=gmail
BENSON_OUTREACH_DRAFTS_PER_DAY=5
BENSON_AUTO_DRAFT_ENABLED=true
OUTREACH_FOLLOW_UP_DAYS=5
INTAKE_OPENAI_ENABLED=true

# Telegram backup alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Backup channel for sponsor email + follower milestones (GIF celebrations at 5K)
TELEGRAM_OUTREACH_ENABLED=true

# --- Benson Website Manager (kckellie.com) ---
