# PUBLIC_API_URL=https://api.kckellie.com
# API_PUBLIC_URL=https://api.kckellie.com
# WEBSITE_MEDIA_UPLOAD_DIR=uploads/website-media
# WEBSITE_MEDIA_MAX_BYTES=26214400
